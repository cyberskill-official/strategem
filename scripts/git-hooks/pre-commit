#!/usr/bin/env bash
# Combined pre-commit (install → .git/hooks/pre-commit):
#   1) CyberOS status page regen (blocking) when FR/CHANGELOG/VERSION staged
#   2) Quality lint on staged py/web/rust
#   3) Status-sync count check
#
#   cp scripts/git-hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#
# migrate-frs --page is permanent (do not remove). Layout migrate is one-time.
set -euo pipefail

root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$root" || exit 1

staged="$(git diff --cached --name-only || true)"
matches() { grep -Eq "$1" <<<"$staged"; }

# —— 1) Status page ——
status_trigger='^(docs/feature-requests/|CHANGELOG\.md$|VERSION$)'
if matches "$status_trigger"; then
  migrate=""
  [ -f "$root/.cyberos/migrate-frs.sh" ] && migrate="$root/.cyberos/migrate-frs.sh"
  if [ -z "$migrate" ]; then
    echo "cyberos: ERROR .cyberos/migrate-frs.sh missing — run cyberos init" >&2
    exit 1
  fi
  if ! command -v node >/dev/null 2>&1; then
    echo "cyberos: ERROR node required for docs/status regen" >&2
    exit 1
  fi
  echo "cyberos: regenerating docs/status/ …"
  bash "$migrate" --page "$root" || {
    echo "cyberos: ERROR status regen failed" >&2
    exit 1
  }
  git add docs/status/ 2>/dev/null || true
  echo "cyberos: docs/status staged"
  if [ -x scripts/check-status-sync.sh ]; then
    bash scripts/check-status-sync.sh
  fi
fi

# —— 2) Version stamp if VERSION staged ——
if matches '^VERSION$'; then
  if [ -f package.json ] && command -v node >/dev/null 2>&1; then
    pkg="$(node -e 'console.log(JSON.parse(require("fs").readFileSync("package.json","utf8")).version||"")')"
    ver="$(tr -d ' \n\r' < VERSION)"
    if [ -n "$ver" ] && [ -n "$pkg" ] && [ "$ver" != "$pkg" ]; then
      echo "cyberos: ERROR VERSION ($ver) != package.json ($pkg)" >&2
      exit 1
    fi
  fi
fi

# —— 3) Quality on staged files ——
if [ -f scripts/git-hooks/pre-commit-quality.sh ]; then
  bash scripts/git-hooks/pre-commit-quality.sh || exit 1
fi

# Rust fmt on staged .rs (fast)
if matches '\.rs$'; then
  if command -v cargo >/dev/null 2>&1; then
    echo "pre-commit: cargo fmt --check (rust staged)"
    cargo fmt --all -- --check || {
      echo "pre-commit: run cargo fmt --all" >&2
      exit 1
    }
  fi
fi

exit 0
