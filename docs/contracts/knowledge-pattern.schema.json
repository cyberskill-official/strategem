{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tamthuc.local/contracts/knowledge-pattern.schema.json",
  "title": "KnowledgePattern",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "system",
    "name",
    "conditions",
    "polarity",
    "meaning_classical",
    "meaning_modern",
    "version",
    "confidence"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "system": { "type": "string", "enum": ["qimen", "liuren", "taiyi", "all"] },
    "name": { "type": "string" },
    "name_han": { "type": "string" },
    "conditions": { "type": "object", "minProperties": 1 },
    "polarity": { "type": "string", "enum": ["cat", "hung", "trung"] },
    "meaning_classical": { "type": "string" },
    "meaning_modern": { "type": "string" },
    "citations": { "type": "array", "items": { "type": "string" } },
    "version": { "type": "integer", "minimum": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "status": { "type": "string", "enum": ["active", "draft", "deprecated"] }
  }
}
