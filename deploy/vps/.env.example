# Copy to deploy/vps/.env on the VPS (never commit .env)

# Supabase Postgres (API runtime — pooler as strategem_app, D-DB-001)
# Never use the postgres superuser for DATABASE_URL in production.
DATABASE_URL=postgresql://strategem_app:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Prefer direct privileged URL for migrate.sh only
DATABASE_URL_MIGRATE=postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres
# ALLOW_PRIVILEGED_DB=1  # break-glass only — never in production

# Public site name for Caddy
API_SITE=api.example.com

# Image from GHCR (set by CI on deploy)
API_IMAGE=ghcr.io/cyberskill-official/strategem-api:main

# Auth / crypto — REQUIRED in non-development (no working defaults)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
TAMTHUC_AUTH_JWT_SECRET=
# Generate: python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
TAMTHUC_AUTH_MASTER_KEY_B64=

# PayOS (single VN payment rail) — REQUIRED for live entitlement (fail-closed if unset)
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# PAYOS_PREMIUM_AMOUNT_VND=79000
# Local unsigned mocks only: PAYMENTS_MODE=mock
PAYMENTS_MODE=

# CORS — REQUIRED outside ENV/APP_ENV=development|dev|test (TT-010).
# Never use bare `*` (credentials are enabled). List exact origins, comma-separated.
# Must include the Vercel web origin(s).
# CORS_ORIGINS=https://app.example.com,https://preview.example.com
APP_ENV=production
# Rate limit is on by default outside development/test (TT-011).
# DISABLE_RATE_LIMIT=1

# Optional operator BYOK LLM (prefer admin API /operator/llm-settings)
# LLM_BACKEND=openai_compatible
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=
# LLM_API_KEY=

CAST_CLI=/usr/local/bin/cast-cli
HOST=0.0.0.0
PORT=8000
