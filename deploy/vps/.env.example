# Copy to deploy/vps/.env on the VPS (never commit .env)

# Supabase Postgres (API runtime — pooler OK)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Prefer direct for migrate.sh (optional override)
# DATABASE_URL_MIGRATE=postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres

# Public site name for Caddy
API_SITE=api.example.com

# Image from GHCR (set by CI on deploy)
API_IMAGE=ghcr.io/cyberskill-official/strategem-api:main

# Auth / crypto (names only — generate strong values)
TAMTHUC_AUTH_JWT_SECRET=change-me-min-32-bytes-secret-value!!
# TAMTHUC_AUTH_MASTER_KEY=...

# CORS origins for Vercel web
# CORS_ORIGINS=https://app.example.com,https://*.vercel.app

CAST_CLI=/usr/local/bin/cast-cli
HOST=0.0.0.0
PORT=8000
